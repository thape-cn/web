<div class="hover-card news-card <%= browser.device.mobile? ? 'hover-card-visible' : '' %>">
  <div class="relative overflow-hidden border border-thape-dark-gray w-full">
  <%= link_to news_path(id: info.id) do %>
    <img src="<%= news_image_url -%>" class="w-full h-full max-w-full hover-card-image" />
    <div class="hover-card-panel absolute bg-thape-white-t95 top-0 left-0 h-full flex flex-col justify-between w-2/3 pointer-events-none">
      <div class="my-6 mx-6">
        <p class="<%= fdsz('text-2xl sm:text-3xl') -%> text-justify font-bold"><%= Date::ABBR_MONTHNAMES[info.created_at.month] -%></p>
        <p class="<%= fdsz('text-3xl sm:text-5xl') -%> text-justify tracking-widest font-bold leading-9"><%= info.created_at.day -%></p>
      </div>
      <div class="mb-10 mx-6">
        <p class="font-medium text-lg <%= fdsz("sm:text-lg", "sm:text-3xl") -%> leading-tight text-left pb-1 text-justify"><%= info.title -%></p>
        <p class="font-light text-sm <%= fdsz("sm:text-sm", "sm:text-2xl") -%> leading-tight text-left mt-2"><%= info.sub_title -%></p>
      </div>
    </div>
  <% end %>
  </div>
</div>
