<%= render partial: 'shared/thape_nav', locals: { need_black_header: @wallpapers.first&.wall_paper_need_black_header? } -%>

<div class="fixed w-full h-full z-0">
  <div
    class="thape-slide work-carousel home-carousel"
    data-controller="home-carousel"
    data-home-carousel-interval-value="5000"
    data-action="focusin->home-carousel#pauseOnFocus pointerenter->home-carousel#pointerEnter pointerleave->home-carousel#pointerLeave"
    role="region" aria-roledescription="<%= t('work_carousel.carousel') %>" aria-label="<%= t('home_carousel.label') %>"
  >
    <% if @wallpapers.size > 1 %>
      <div class="work-carousel-controls">
        <button type="button" class="work-carousel-rotation" data-home-carousel-target="rotation" data-action="home-carousel#resume" hidden>
          <span data-home-carousel-target="pauseLabel" hidden><%= t('work_carousel.pause') %></span>
          <span data-home-carousel-target="playLabel" hidden><%= t('work_carousel.play') %></span>
        </button>
        <span class="work-carousel-status" data-home-carousel-target="status" aria-live="off" aria-atomic="true">1 / <%= @wallpapers.size %></span>
      </div>
    <% end %>
    <div class="slide-images">
      <% @wallpapers.each_with_index do |wallpaper, index| %>
        <div data-type="slide-item" data-home-carousel-target="slide" data-wall-paper-need-black-header="<%= wallpaper.wall_paper_need_black_header? %>" class="image-item <%= 'active' if index.zero? %>"
          role="group" aria-roledescription="<%= t('work_carousel.slide') %>" aria-label="<%= t('work_carousel.position', number: index + 1, total: @wallpapers.size) %>"
          aria-hidden="<%= !index.zero? %>" <%= 'inert' unless index.zero? %>>
          <% image_title = wallpaper.title.presence || wallpaper.subtitle.presence || t('home_carousel.untitled', number: index + 1) %>
          <% image = capture do %>
            <picture>
              <% if wallpaper.mobile_image.identifier.present? %><source srcset="<%= wallpaper.mobile_image.url %>" media="(max-width: 768px)" /><% end %>
              <img src="<%= wallpaper.image.url %>" alt="<%= wallpaper.link.present? ? '' : image_title %>" />
            </picture>
          <% end %>
          <%= link_to_if wallpaper.link.present?, image, wallpaper.link, class: 'home-carousel-link block w-full h-full', target: '_blank', rel: 'noopener', aria: { label: t('home_carousel.open_link', title: image_title) } %>
          <div class="home-carousel-caption absolute text-white bottom-0 left-0 right-0 break-all px-2 md:px-6 lg:px-8 xl:px-10 xxl:px-12 xxxl:px-16 py-3 md:py-10">
            <p class="<%= fdsz("text-base sm:text-lg lg:text-2xl", "text-base sm:text-2xl lg:text-3xl") -%> text-left pb-1 font-medium leading-none sm:leading-tight"><%= wallpaper.title %></p>
            <p class="<%= fdsz("text-xs sm:text-base lg:text-lg", "text-xs sm:text-xl lg:text-2xl") -%> text-left leading-none md:leading-snug tracking-tight sm:tracking-normal" style="word-break: keep-all;"><%= wallpaper.subtitle %></p>
          </div>
        </div>
      <% end %>
    </div>
    <% if @wallpapers.size > 1 %>
      <button type="button" class="action-area action-left" data-action="home-carousel#previous" aria-label="<%= t('work_carousel.previous') %>">
        <img class="w-4 lg:w-8" src="<%= asset_pack_path('static/images/arrow_left.svg') %>" alt="" />
      </button>
      <button type="button" class="action-area action-right" data-action="home-carousel#next" aria-label="<%= t('work_carousel.next') %>">
        <img class="w-4 lg:w-8" src="<%= asset_pack_path('static/images/arrow_right.svg') %>" alt="" />
      </button>
    <% end %>
  </div>
</div>

<div data-controller="home"
     data-action="resize@window->home#layout"
     data-home-offset-value="0.75"
     data-home-amplify-rate-value="2.3">

<div class="relative" style="margin-top: 100vh; z-index: 1;">

<%# 最新项目 %>
<div class="w-full mx-auto px-2 md:px-6 lg:px-8 xl:px-10 xxl:px-12 xxxl:px-16 bg-white scroller-step" style="opacity: 0.001;" id="thape-new-projects">
  <header>
    <div class="flex w-full pt-4 pb-2 sm:pt-10 sm:pb-4 justify-between items-center">
      <div class="flex items-end">
        <h1 class="p-0 <%= fdsz("text-lg sm:text-2xl", "text-xl sm:text-4xl") -%> font-bold text-black6c">
          <a href="<%= works_path(locale: 'cn', anchor: 'thape-new-projects') -%>" class="hover:text-black6c-t70 focus:text-black6c-t70">最新项目</a>
        </h1>
        <h2 class="ml-2 <%= fdsz("text-sm sm:text-lg", "text-base sm:text-3xl") -%> text-black6c">
          <a href="<%= works_path(locale: 'en', anchor: 'thape-new-projects') -%>" class="font-medium hover:text-black6c-t70 focus:text-black6c-t70">NEW PROJECTS</a>
        </h2>
      </div>
      <a class="py-1 md:py-2 px-2 sm:px-5 border border-black <%= fdsz('text-sm') -%> font-medium rounded-full text-black bg-thape-white-t80 shadow-sm active:bg-black6c-t70 hover:bg-black6c focus:text-black6c hover:text-white focus:text-white transition duration-150 ease-in-out leading-snug sm:leading-normal" href="<%= works_path -%>">
        MORE+
      </a>
    </div>
  </header>
  <%= render partial: 'new_projects' %>
</div>

<div class="relative w-full mx-auto px-2 md:px-6 lg:px-8 xl:px-10 xxl:px-12 xxxl:px-16 bg-white scroller-step" id="thape-home-news">
  <%# 天华新闻 %>
  <header>
    <div class="flex w-full pt-4 pb-2 sm:pt-10 sm:pb-4 justify-between items-center">
      <div class="flex items-end">
        <h1 class="p-0 <%= fdsz("text-lg sm:text-2xl", "text-xl sm:text-4xl") -%> font-bold text-black6c">
          <a href="<%= news_index_path(locale: 'cn', anchor: 'thape-home-news') -%>" class="hover:text-black6c-t70 focus:text-black6c-t70">天华新闻</a>
        </h1>
        <h2 class="ml-2 <%= fdsz("text-sm sm:text-lg", "text-base sm:text-3xl") -%> text-black6c">
          <a href="<%= news_index_path(locale: 'en', anchor: 'thape-home-news') -%>" class="font-medium hover:text-black6c-t70 focus:text-black6c-t70">NEWS</a>
        </h2>
      </div>
      <a class="py-1 md:py-2 px-2 sm:px-5 border border-black <%= fdsz('text-sm') -%> font-medium rounded-full text-black bg-thape-white-t80 shadow-sm active:bg-black6c-t70 hover:bg-black6c focus:text-black6c hover:text-white focus:text-white transition duration-150 ease-in-out leading-snug sm:leading-normal" href="<%= news_index_path -%>">
        MORE+
      </a>
    </div>
  </header>
  <div class="flex-grid">
    <div class="flex-grid-box flex-grid-cols-1-gap-1 sm:flex-grid-cols-2-gap-2 lg:flex-grid-cols-3-gap-2">
    <%= render partial: 'new_square',
      locals: { news_image_url: @tail_home.info_1_photo.url, info: @tail_home.news_1, padding_y: 'pr-1 sm:pr-2 lg:pr-4' } %>
    <%= render partial: 'new_square',
      locals: { news_image_url: @tail_home.info_2_photo.url, info: @tail_home.news_2, padding_y: 'px-1 sm:px-1 lg:px-2' } %>
    <%= render partial: 'new_square',
      locals: { news_image_url: @tail_home.info_3_photo.url, info: @tail_home.news_3, padding_y: 'pl-1 sm:pl-2 lg:pl-4' } %>
    </div>
  </div>
</div>

<%# 访客留言 %>
<div class="bg-white sm:py-8">
<%= render partial: 'shared/guest_form' %>
</div>

</div>
</div>
<%= render partial: 'shared/footer' %>
