<dl class="p-0 sm:px-2 sm:py-1 text-white hover:bg-gray-50 hover:text-black6c cursor-pointer flex items-center flex-wrap"
  data-biz-map-target="city" data-city="<%= c %>" data-active-class="bg-gray-50 text-black6c" data-inactive-class="bg-thape-city-gray text-white"
  role="button" tabindex="0" aria-pressed="false" data-action="click->biz-map#selectCity keydown->biz-map#selectCity">
  <dt class="font-medium <%= fdsz("text-base sm:text-base", "text-base sm:text-xl") -%> text-center flex-none w-full"><%= dc -%></dt>
  <dd class="font-light text-center <%= fdsz("text-xs sm:text-sm", "text-xs sm:text-base") -%> flex-none w-full tracking-tighter sm:tracking-normal"><%= e -%></dd>
</dl>
