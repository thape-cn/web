<div class="relative bg-white" style="height: 1px;" data-main-target="footerLine"></div>
<footer class="bg-thape-dark-gray py-4 w-full flex-none md:py-6 px-2 md:px-6 lg:px-8 xl:px-10 xxl:px-12 xxxl:px-16 relative" data-main-target="footer">
  <div class="w-full">
    <nav class="flex items-center justify-center flex-no-wrap pb-2 md:pb-4 md:justify-between border-b border-gray-300">
      <div class="items-center hidden md:flex">
        <a href="<%= root_path -%>">
          <%= render partial: 'shared/logo', locals: { className: '', svgId: 'thape-footer-logo' } -%>
        </a>
      </div>
      <div class="flex justify-center flex-none flex-wrap items-center w-48 <%= fdsz("text-sm sm:text-base", "text-sm sm:text-xl") -%> text-thape-copyright-gray cursor-pointer md:w-auto md:justify-end">
        <a href="<%= biz_map_path -%>" class="flex-none my-0 md:my-1 block w-1/2 text-center md:w-auto md:font-medium hover:text-black6c focus:outline-none focus:text-black6c transition duration-150 ease-in-out"><%= t("footer.contact") -%></a>
        <span class="hidden mx-2 md:inline md:mx-3">|</span>
        <a href="<%= statement_sites_path -%>" class="flex-none my-0 md:my-1 block w-1/2 text-center md:w-auto md:font-medium hover:text-black6c focus:outline-none focus:text-black6c transition duration-150 ease-in-out"><%= t("footer.statement") -%></a>
        <span class="hidden mx-2 md:inline md:mx-3">|</span>
        <a href="<%= privacy_sites_path -%>" class="flex-none my-0 md:my-1 block w-1/2 text-center md:w-auto md:font-medium hover:text-black6c focus:outline-none focus:text-black6c transition duration-150 ease-in-out"><%= t("footer.privacy") -%></a>
        <span class="hidden mx-2 md:inline md:mx-3">|</span>
        <a href="<%= disclaimer_sites_path -%>" class="flex-none my-0 md:my-1 block w-1/2 text-center md:w-auto md:font-medium hover:text-black6c focus:outline-none focus:text-black6c transition duration-150 ease-in-out"><%= t("footer.disclaimer") -%></a>
        <span class="hidden mx-2 md:inline md:mx-3">|</span>
        <a href="https://tianhua.gllue.com/portal/campus" target="_blank" class="flex-none my-0 md:my-1 block w-1/2 text-center md:w-auto md:font-medium hover:text-black6c focus:outline-none focus:text-black6c transition duration-150 ease-in-out"><%= t("footer.careers") -%></a>
      </div>
    </nav>
  </div>
  <div class="w-full flex justify-center flex-wrap mt-4 md:justify-between md:flex-no-wrap md:mt-6">
    <div class="<%= fdsz("text-sm sm:text-base", "text-sm sm:text-xl") -%> flex-none w-full text-thape-copyright-gray md:w-auto md:flex-auto">
      <p class="hidden md:block"><%= t('footer.telephone_exchange') -%>：021-34189900 / 021-64281588 &nbsp;&nbsp;&nbsp;<%= t('footer.contact_hotline') -%>：400-8366606 / 021-64281588 转 1</p>
      <p class="hidden md:block leading-loose"><%= raw t("footer.corporation") -%></p>

      <p class="md:hidden text-center"><%= t('footer.telephone_exchange') -%>：021-34189900 / 021-64281588</p>
      <p class="md:hidden text-center"><%= t('footer.contact_hotline') -%>：400-8366606 / 021-64281588 转 1</p>
      <p class="md:hidden text-center"><%= raw t("footer.corporation") -%></p>
    </div>

    <div class="flex order-first flex-none w-full pb-2 text-thape-icon-gray justify-center items-center md:order-last md:pb-0 md:w-auto md:pl-4">
      <div class="relative social-qr">
        <%= image_pack_tag 'images/wechat-qr.jpg', class: 'social-qr-image absolute w-36 z-50 max-w-none', style: 'top: -168px; left: -64px;', id: 'wechat-qr', alt: '微信二维码' %>
        <button type="button" aria-label="微信二维码" aria-describedby="wechat-qr"><%= image_pack_tag 'images/wechat.svg', class: 'h-4 md:h-6 mx-2 md:mr-2 md:ml-0' -%></button>
      </div>
      <a href="http://weibo.com/thape" target="_blank" rel="noreferrer"><%= image_pack_tag 'images/weibo.svg', class: 'h-4 md:h-6 mx-2' %></a>
      <a href="https://www.zhihu.com/org/tian-hua-jian-zhu/activities" target="_blank" rel="noreferrer"><%= image_pack_tag 'images/zhihu.svg', class: 'h-4 md:h-6 mx-2' %></a>
      <div class="relative social-qr">
        <%= image_pack_tag 'images/shipinhao-qr.jpg', class: 'social-qr-image absolute w-44 z-50 max-w-none', style: 'top: -220px; left: -74px;', id: 'shipinhao-qr', alt: '视频号二维码' %>
        <button type="button" aria-label="视频号二维码" aria-describedby="shipinhao-qr"><%= image_pack_tag 'images/shipinhao.svg', class: 'h-4 md:h-6 mx-2' -%></button>
      </div>
      <a href="https://space.bilibili.com/380792461" target="_blank" rel="noreferrer"><%= image_pack_tag 'images/bilibili.svg', class: 'h-4 md:h-6 mx-2' %></a>
      <div class="relative social-qr">
        <%= image_pack_tag 'images/xiaohongshu-qr.jpg', class: 'social-qr-image absolute w-44 z-50 max-w-none', style: 'top: -220px; right: 0px;', id: 'xiaohongshu-qr', alt: '小红书二维码' %>
        <button type="button" aria-label="小红书二维码" aria-describedby="xiaohongshu-qr"><%= image_pack_tag 'images/xiaohongshu.svg', class: 'h-4 md:h-6 mx-2 md:ml-2 md:mr-0' -%></button>
      </div>
    </div>
  </div>
</footer>
