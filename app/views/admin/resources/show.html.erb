<% content_for :page_title, "#{@resource.label} · #{@record.id}" %>
<div class="admin-page-heading">
  <div><%= link_to '← 返回列表', admin_back_path(@resource), class: 'admin-link inline-block text-sm mb-4' %><h1 class="admin-page-title"><%= @resource.label %> · <%= @record.id %></h1><p class="admin-page-description"><%= admin_resource_description(@resource) %></p></div>
  <% if @resource.allows?(:edit) %><%= link_to '编辑', admin_resource_path(@resource, :edit, @record), class: 'admin-button' %><% end %>
</div>
<section class="admin-panel overflow-hidden">
  <div class="px-6 py-6 border-b border-gray-100"><h2 class="text-base font-semibold">详细信息</h2><p class="text-sm text-gray-500 mt-2">记录 #<%= @record.id %> · <%= admin_locale_label %></p></div>
  <dl class="admin-description-list divide-y divide-gray-100">
    <% fields = @resource.messages? ? @record.attribute_names - ['updated_at'] : @resource.fields.keys %>
    <% fields.each do |field| %>
      <div class="admin-description-row">
        <dt><%= admin_field_label(@resource, field) %></dt>
        <dd><% if @resource.fields.dig(field, 'type') == 'file_field' %><%= admin_upload_preview(@record.public_send(field)) || '—' %><% elsif @resource.fields.dig(field, 'type') == 'check_box' %><%= admin_status(@record, field) %><% else %><%= admin_display(@record, field) %><% end %></dd>
      </div>
    <% end %>
  </dl>
</section>
