<% content_for :page_title, "#{@resource.label} · #{@record.id}" %>
<% actions = @resource.allows?(:edit) ? [{label: '编辑', path: admin_resource_path(@resource, :edit, @record)}] : [] %>
<%= render 'admin/shared/heading', title: "#{@resource.label} · #{@record.id}", description: admin_resource_description(@resource), breadcrumbs: admin_breadcrumbs(@resource, "记录 ##{@record.id}"), actions: actions %>
<section class="admin-panel admin-detail-panel overflow-hidden" aria-labelledby="record-details-heading">
  <%= render 'admin/shared/card_heading', heading_id: 'record-details-heading', title: t('admin.details.title'), description: t('admin.details.record', id: @record.id, language: admin_locale_label), class_name: 'admin-description-heading' %>
  <dl class="admin-description-list divide-y divide-gray-100">
    <% fields = @resource.messages? ? @record.attribute_names - ['updated_at'] : @resource.fields.keys %>
    <% fields.each do |field| %>
      <div class="admin-description-row">
        <dt><%= admin_field_label(@resource, field) %></dt>
        <dd class="<%= 'admin-description-file' if @resource.fields.dig(field, 'type') == 'file_field' %>"><% if @resource.fields.dig(field, 'type') == 'file_field' %><%= render 'admin/shared/attachment', upload: @record.public_send(field) %><% elsif @resource.fields.dig(field, 'type') == 'check_box' %><%= admin_status(@record, field) %><% else %><%= admin_display(@record, field) %><% end %></dd>
      </div>
    <% end %>
  </dl>
</section>
