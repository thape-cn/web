<% content_for :page_title, @resource.label %>
<% search_field = @resource.search_field %>
<% filtered = admin_list_context.slice('q', *@resource.filters.keys).any? %>
<%= render 'admin/shared/heading', title: @resource.label, description: admin_resource_description(@resource), breadcrumbs: admin_breadcrumbs(@resource), actions: admin_index_actions(@resource) %>
<% if @resource.ordered? %>
  <dialog id="admin-order-dialog" class="admin-order-dialog" aria-labelledby="admin-order-dialog-title" data-admin-order-dialog>
    <div class="admin-order-dialog-heading">
      <h2 id="admin-order-dialog-title">调整展示顺序</h2>
      <button type="button" class="admin-icon-button" data-admin-order-close aria-label="关闭排序窗口"><%= admin_icon('close') %></button>
    </div>
    <div data-admin-order-content></div>
  </dialog>
<% end %>
<div class="admin-panel overflow-hidden">
  <% if @resource.tab_filter %><%= render 'admin/shared/filter_tabs', resource: @resource, field: @resource.tab_filter %><% end %>
  <%= form_with url: admin_resource_path(@resource), method: :get, local: true, class: 'admin-filter-bar' do |form| %>
    <%= hidden_field_tag :locale, admin_locale %>
    <% if @resource.tab_filter && admin_list_context[@resource.tab_filter] %><%= hidden_field_tag @resource.tab_filter, admin_list_context[@resource.tab_filter] %><% end %>
    <% if search_field %>
      <div class="admin-search-field">
        <%= form.label :q, '搜索名称 / 标题', class: 'sr-only' %>
        <div class="relative"><span class="admin-search-icon"><%= admin_icon('search') %></span><%= form.search_field :q, value: admin_list_context["q"], placeholder: '搜索名称 / 标题…', class: 'admin-input admin-search-input' %></div>
      </div>
    <% end %>
    <% @resource.filters.except(@resource.tab_filter).each do |field, label| %>
      <div class="admin-filter-select"><%= form.label field, label, class: 'text-sm text-gray-500' %><%= form.select field, options_for_select(@resource.filter_options(field), admin_list_context[field]), { include_blank: "全部#{label}" }, class: 'admin-input' %></div>
    <% end %>
    <% if @resource.key == 'pictures' %><%= hidden_field_tag :view, admin_list_context.fetch('view', 'grid') %><% end %>
    <% page_size = admin_list_context.fetch('per_page', '25').to_i %>
    <div class="admin-filter-select"><%= form.label :per_page, '每页条数', class: 'text-sm text-gray-500 whitespace-no-wrap' %><%= form.select :per_page, options_for_select(([25, 50, 100] + [page_size]).uniq.sort, page_size), {}, class: 'admin-input' %></div>
    <%= form.submit '筛选', class: 'admin-button-secondary' %>
  <% end %>
  <%= render 'admin/shared/active_filters', filters: admin_active_filters %>
  <% if @resource.key == 'pictures' %>
    <div class="admin-view-toolbar">
      <span class="text-sm text-gray-500">共 <%= @records.total_count %> 张图片</span>
      <nav class="admin-view-switch admin-button-group" aria-label="图片浏览方式">
        <% [['grid', '网格', 'grid'], ['list', '列表', 'menu']].each do |view, label, icon| %>
          <% current = admin_list_context.fetch('view', 'grid') == view %>
          <%= link_to admin_list_path(view: view), class: ['admin-button-secondary', ('admin-view-current' if current)], aria: {current: current ? 'true' : nil} do %><%= admin_icon(icon) %><%= label %><% end %>
        <% end %>
      </nav>
    </div>
  <% end %>
  <% if @records.empty? %>
    <% empty_action = filtered ? {label: '清除筛选', path: admin_clear_filters_path, secondary: true} : (@resource.allows?(:new) ? {label: '新建第一条记录', path: admin_resource_path(@resource, :new)} : nil) %>
    <%= render 'admin/shared/empty_state', icon: filtered ? 'search' : 'folder', title: filtered ? '没有找到匹配的记录' : '暂无记录', description: filtered ? '试试其他关键词或清除筛选条件。' : '此模块的内容会显示在这里。', action: empty_action %>
  <% elsif @resource.key == 'pictures' && admin_list_context.fetch('view', 'grid') == 'grid' %>
    <ul class="admin-media-grid" aria-label="图片库">
      <% @records.each do |record| %>
        <li id="record-<%= record.id %>">
          <%= render layout: 'admin/shared/media_card', locals: {title: "图片 ##{record.id}", image_url: record.image.url, filename: record.image.identifier, metadata: ["新闻 ID：#{record.info_id || '—'}"]} do %>
            <%= render 'admin/shared/record_actions', resource: @resource, record: record %>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% elsif @resource.key == 'seos' %>
    <% @records.each do |record| %>
      <section class="admin-seo-section admin-editor-section" aria-labelledby="seo-<%= record.id %>-heading">
        <div class="admin-editor-heading"><h2 id="seo-<%= record.id %>-heading" class="text-base font-semibold"><%= record.seo_name %></h2><p class="text-sm text-gray-500 mt-2 leading-relaxed">页面搜索信息 · <%= admin_locale_label %></p></div>
        <div class="admin-panel admin-form-section min-w-0">
          <%= form_with model: record, scope: :seo, url: admin_resource_path(@resource, :update, record), method: :patch, local: true do |form| %>
            <div class="admin-fields">
              <% @resource.fields.each do |field, options| %><%= render 'admin/shared/field', form: form, resource: @resource, field: field, options: options %><% end %>
            </div>
            <div class="flex justify-end mt-6"><%= form.submit '保存', class: 'admin-button' %></div>
          <% end %>
        </div>
      </section>
    <% end %>
  <% else %>
    <% if @resource.ordered? %>
      <div class="admin-order-guide">
        <strong>展示顺序</strong>
        <span>序号从 1 开始。使用箭头或「移动」调整顺序，保存后立即生效。<span data-admin-drag-hint hidden>也可拖动手柄到当前页其他记录的前后。</span></span>
        <span>排序作用于本模块全部记录（含其他分页、筛选外及未发布记录），所有内容语言共用。</span>
      </div>
      <%= form_with url: admin_resource_path(@resource, :reorder, @records.first), method: :patch, local: true, html: { hidden: true }, data: { admin_drag_form: true } do %>
        <% admin_order_context.each do |key, value| %><%= hidden_field_tag key, value, id: nil %><% end %>
        <%= hidden_field_tag :movement, '', id: nil %>
        <%= hidden_field_tag :target_id, '', id: nil %>
      <% end %>
    <% end %>
    <div class="admin-table-scroll" role="region" aria-label="<%= @resource.label %>列表，可横向滚动" tabindex="0">
      <table class="admin-table min-w-full divide-y divide-gray-200" <%= 'data-admin-order-table' if @resource.ordered? %>>
        <caption class="sr-only"><%= @resource.label %>列表</caption>
        <thead><tr>
          <% if @resource.ordered? %><th scope="col" class="admin-order-column" aria-sort="ascending">展示顺序</th><% end %>
          <% @resource.columns.each do |field| %><th scope="col"><%= admin_field_label(@resource, field) %></th><% end %>
          <th scope="col" class="admin-table-actions">操作</th>
        </tr></thead>
        <tbody class="bg-white divide-y divide-gray-100">
          <% @records.each do |record| %>
            <tr id="record-<%= record.id %>" <%= tag.attributes(data: { record_id: record.id, reorder_url: admin_resource_path(@resource, :reorder, record) }) if @resource.ordered? %>>
              <% if @resource.ordered? %><td class="admin-order-column"><%= render 'admin/shared/ordering', record: record %></td><% end %>
              <% @resource.columns.each_with_index do |field, index| %>
                <td class="<%= field == 'id' ? 'admin-record-id' : (index == 1 ? 'admin-record-name' : '') %>">
                  <% if @resource.fields.dig(field, 'type') == 'file_field' %>
                    <%= admin_upload_preview(record.public_send(field)) || '—' %>
                  <% elsif @resource.fields.dig(field, 'type') == 'check_box' %>
                    <%= admin_status(record, field) %>
                  <% else %>
                    <%= truncate(admin_display(record, field), length: 100) %>
                    <% if @resource.key == 'users' && field == 'name' && record.id == current_admin.id %><span class="admin-badge admin-badge-neutral ml-2">当前账号</span><% end %>
                  <% end %>
                </td>
              <% end %>
              <td class="admin-table-actions">
                <%= render 'admin/shared/record_actions', resource: @resource, record: record %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
  <%= render 'admin/shared/pagination', records: @records %>
</div>
