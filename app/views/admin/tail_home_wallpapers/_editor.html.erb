<div data-wallpaper-editor data-min="<%= TailHome::MIN_WALLPAPERS %>" data-max="<%= TailHome::MAX_WALLPAPERS %>" data-slide-label="<%= t('admin.home_wallpaper.slide', number: '__NUMBER__') %>" data-count-label="<%= t('admin.home_wallpaper.count', count: '__COUNT__') %>">
  <%= render layout: 'admin/shared/section_heading', locals: { heading_id: 'wallpaper-management-heading', title: tag.span(t('admin.home_wallpaper.count', count: @record.wallpapers.reject(&:marked_for_destruction?).size), role: 'status', data: {wallpaper_count: true}), description: t('admin.home_wallpaper.manage_hint'), actions: true } do %>
    <button type="button" class="admin-button-secondary" data-wallpaper-add hidden><%= admin_icon('plus') %><%= t('admin.home_wallpaper.add') %></button>
  <% end %>
  <noscript><p class="admin-field-hint"><%= t('admin.home_wallpaper.javascript_hint') %></p></noscript>
  <div data-wallpaper-list>
    <%= form.fields_for :wallpapers, @record.wallpapers.sort_by { |wallpaper| wallpaper.position.to_i } do |wallpaper_form| %>
      <% number = wallpaper_form.object.marked_for_destruction? ? "removed-#{wallpaper_form.index}" : wallpaper_form.object.position %>
      <%= render 'admin/tail_home_wallpapers/slide', form: wallpaper_form, number: number %>
    <% end %>
  </div>
  <template data-wallpaper-template>
    <%= form.fields_for :wallpapers, TailHomeWallpaper.new, child_index: 'NEW_WALLPAPER' do |wallpaper_form| %>
      <%= render 'admin/tail_home_wallpapers/slide', form: wallpaper_form, number: 'NEW_WALLPAPER' %>
    <% end %>
  </template>
</div>
