<section class="max-w-md mx-auto mt-12 bg-white p-8 rounded-lg shadow">
  <h1 class="text-2xl font-semibold mb-6">管理员登录</h1>
  <%= form_with scope: :session, url: admin_login_path, local: true do |form| %>
    <div class="mb-4">
      <%= form.label :email, '邮箱' %>
      <%= form.email_field :email, required: true, autocomplete: 'username', autofocus: true, value: params.dig(:session, :email), class: 'admin-input' %>
    </div>
    <div class="mb-6">
      <%= form.label :password, '密码' %>
      <%= form.password_field :password, required: true, autocomplete: 'current-password', class: 'admin-input' %>
    </div>
    <%= form.submit '登录', class: 'admin-button' %>
  <% end %>
</section>
