<% content_for :page_title, '管理员登录' %>
<div class="text-center mb-8">
  <%= image_tag asset_pack_path('static/images/logo.svg'), alt: '天华 TIANHUA', class: 'admin-wordmark mx-auto mb-8' %>
  <h1 class="text-2xl font-bold tracking-tight">管理员登录</h1>
  <p class="text-sm text-gray-500 mt-3">登录以管理网站内容</p>
</div>
<section class="admin-panel p-6 sm:p-10">
  <%= form_with scope: :session, url: admin_login_path, local: true do |form| %>
    <div class="mb-6">
      <%= form.label :email, '邮箱', class: 'admin-label' %>
      <%= form.email_field :email, required: true, autocomplete: 'username', autofocus: true, value: params.dig(:session, :email), placeholder: '管理员邮箱', class: 'admin-input' %>
    </div>
    <div class="mb-8">
      <%= form.label :password, '密码', class: 'admin-label' %>
      <%= form.password_field :password, required: true, autocomplete: 'current-password', class: 'admin-input' %>
    </div>
    <%= form.submit '登录', class: 'admin-button w-full' %>
  <% end %>
</section>
<div class="mt-8 text-center"><%= link_to '/', class: 'admin-link text-sm' do %>返回天华官网 <span aria-hidden="true">↗</span><% end %></div>
