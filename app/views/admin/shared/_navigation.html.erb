<%= link_to admin_root_path, class: 'admin-brand' do %>
  <span><%= image_tag asset_pack_path('static/images/logo.svg'), alt: '天华 TIANHUA', class: 'admin-wordmark' %><span class="block text-xs text-gray-500 mt-3">网站内容管理</span></span>
<% end %>
<nav aria-label="管理菜单" class="admin-navigation">
  <%= link_to admin_root_path, class: "admin-nav-link #{controller_name == 'dashboard' ? 'admin-nav-active' : ''}", aria: { current: controller_name == 'dashboard' ? 'page' : nil } do %>
    <%= admin_icon('grid') %><span>工作台</span>
  <% end %>
  <% admin_navigation_groups.each do |group| %>
    <div class="admin-nav-group">
      <p class="admin-nav-heading"><%= group[:label] %></p>
      <% group[:resources].each do |resource| %>
        <%= link_to admin_resource_path(resource), class: "admin-nav-link #{controller_name == resource.key ? 'admin-nav-active' : ''}", aria: { current: controller_name == resource.key ? 'page' : nil } do %>
          <%= admin_resource_icon(resource) %><span><%= resource.label %></span>
        <% end %>
      <% end %>
    </div>
  <% end %>
</nav>
<div class="admin-account">
  <span class="admin-avatar" aria-hidden="true"><%= current_admin.name.to_s.first&.upcase %></span>
  <div class="min-w-0 flex-1 ml-3"><p class="text-sm font-semibold truncate"><%= current_admin.name %></p><p class="text-xs text-gray-500 mt-1">网站管理员</p></div>
  <%= button_to admin_logout_path, method: :delete, class: 'admin-icon-button', aria: { label: '退出登录' }, title: '退出登录' do %><%= admin_icon('logout') %><span class="sr-only">退出登录</span><% end %>
</div>
