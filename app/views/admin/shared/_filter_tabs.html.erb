<% choices = [['全部', nil]] + resource.filter_options(field) %>
<div class="admin-filter-navigation" data-admin-filter-navigation>
  <div class="admin-filter-mobile" data-admin-filter-mobile hidden>
    <%= label_tag "admin-filter-#{field}", resource.filters.fetch(field), class: 'sr-only' %>
    <select id="admin-filter-<%= field %>" class="admin-input" data-admin-filter-select>
      <% choices.each do |label, value| %>
        <%= tag.option label, value: admin_list_path(**{field => value, 'page' => nil}), selected: admin_list_context[field].to_s == value.to_s %>
      <% end %>
    </select>
  </div>
  <nav class="admin-filter-tabs" aria-label="<%= resource.filters.fetch(field) %>">
    <% choices.each do |label, value| %>
      <% current = admin_list_context[field].to_s == value.to_s %>
      <%= link_to label, admin_list_path(**{field => value, 'page' => nil}), class: current ? 'admin-filter-tab-current' : nil, aria: {current: current ? 'page' : nil} %>
    <% end %>
  </nav>
</div>
