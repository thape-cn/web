<dialog id="admin-module-search" class="admin-dialog admin-command-dialog" aria-labelledby="admin-module-search-title">
  <h2 id="admin-module-search-title" class="sr-only">搜索管理模块</h2>
  <div class="admin-command-input">
    <%= admin_icon('search') %>
    <label for="admin-module-query" class="sr-only">搜索管理模块</label>
    <input id="admin-module-query" type="text" inputmode="search" placeholder="输入模块名称或英文名称…" autocomplete="off" aria-controls="admin-module-results" aria-describedby="admin-module-search-help" autofocus>
    <button type="button" class="admin-icon-button" data-admin-switcher-close aria-label="关闭模块搜索"><%= admin_icon('close') %><span class="sr-only">关闭模块搜索</span></button>
  </div>
  <div id="admin-module-results" class="admin-command-results">
    <% admin_navigation_groups.each do |group| %>
      <section data-admin-command-group aria-label="<%= group[:label] %>">
        <h3 class="admin-command-group-heading"><%= group[:label] %></h3>
        <ul><% group[:resources].each do |resource| %><li data-admin-command-item data-search="<%= [resource.label, resource.key, admin_resource_description(resource)].join(' ') %>"><%= link_to admin_resource_path(resource), class: 'admin-command-link' do %><%= admin_resource_icon(resource) %><span><strong><%= resource.label %></strong><small><%= admin_resource_description(resource) %></small></span><% end %></li><% end %></ul>
      </section>
    <% end %>
    <div class="admin-command-empty" data-admin-command-empty role="status" hidden>
      <%= admin_icon('search') %>
      <p class="mt-4 font-semibold text-gray-900"><%= t('admin.module_search.no_results') %></p>
      <p class="mt-2 text-gray-500"><%= t('admin.module_search.try_again') %></p>
    </div>
  </div>
  <p id="admin-module-search-help" class="admin-command-footer">↑ ↓ 选择 · Enter 打开 · Esc 关闭 · Ctrl / ⌘ K 搜索</p>
</dialog>
