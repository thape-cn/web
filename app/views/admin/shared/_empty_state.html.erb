<div class="admin-empty-state">
  <%= admin_icon(icon, class: 'w-12 h-12 text-gray-400 mx-auto') %>
  <h2 class="text-sm font-semibold mt-2"><%= title %></h2>
  <p class="text-sm text-gray-500 mt-1"><%= description %></p>
  <% if local_assigns[:action] %>
    <div class="mt-6">
      <%= link_to action[:path], class: action[:secondary] ? 'admin-button-secondary' : 'admin-button' do %><%= admin_icon('plus') unless action[:secondary] %><%= action[:label] %><% end %>
    </div>
  <% end %>
</div>
