<div class="admin-card-heading <%= local_assigns[:class_name] %>">
  <div class="min-w-0">
    <%= content_tag local_assigns.fetch(:level, :h2), title, id: heading_id, class: 'text-base font-semibold text-gray-900' %>
    <% if local_assigns[:description].present? %><p class="text-sm text-gray-500 mt-1"><%= description %></p><% end %>
  </div>
  <% if local_assigns[:actions] %><div class="admin-heading-actions"><%= yield %></div><% end %>
</div>
