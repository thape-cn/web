<dialog id="admin-confirmation" class="admin-dialog" aria-labelledby="admin-confirmation-title" aria-describedby="admin-confirmation-message">
  <div class="admin-confirmation-body"><span class="admin-confirmation-icon"><%= admin_icon('alert') %></span><div><h2 id="admin-confirmation-title" class="text-base font-semibold">删除记录</h2><p id="admin-confirmation-message" class="text-sm text-gray-500 mt-3"></p></div></div>
  <div class="admin-dialog-footer"><button type="button" class="admin-button-secondary" data-admin-confirm-cancel autofocus>取消</button><button type="button" class="admin-button-danger" data-admin-confirm-accept>确认删除</button></div>
</dialog>
