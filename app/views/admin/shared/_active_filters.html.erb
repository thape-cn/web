<% if filters.any? %>
  <div class="admin-active-filters" aria-label="已选筛选条件">
    <span class="text-xs text-gray-500">已选筛选</span>
    <ul>
      <% filters.each do |filter| %>
        <li><span class="admin-filter-chip"><span><%= filter[:label] %></span><%= link_to filter[:path], class: 'admin-filter-remove', aria: {label: "移除#{filter[:label]}"} do %><span class="sr-only">移除<%= filter[:label] %></span><%= admin_icon('close') %><% end %></span></li>
      <% end %>
    </ul>
    <%= link_to '清除筛选', admin_clear_filters_path, class: 'admin-link text-xs' %>
  </div>
<% end %>
