<% content_for :page_title, '工作台' %>
<%= render 'admin/shared/heading', title: '网站管理', description: '从这里更新天华的作品、动态与品牌内容。', eyebrow: '天华 · 内容管理', badge: "当前内容 · #{admin_locale_label}" %>
<section aria-labelledby="counts-heading" class="mb-10">
  <h2 id="counts-heading" class="text-base font-semibold mb-2">内容概览</h2>
  <p class="text-xs text-gray-500 mb-4">全部内容语言的记录总数，包含未发布作品。</p>
  <dl class="admin-stats">
    <% @counts.each do |key, count| %>
      <% resource = Admin::Resource.new(key) %>
      <div class="admin-stat-card">
        <dt><%= admin_resource_icon(resource) %><%= link_to resource.label, admin_resource_path(resource), class: 'admin-stat-link', title: resource.label %></dt>
        <dd data-admin-count="<%= key %>"><%= count %></dd>
      </div>
    <% end %>
  </dl>
</section>
<section aria-labelledby="quick-access-heading" class="mb-10">
  <div class="flex items-center justify-between mb-4">
    <h2 id="quick-access-heading" class="text-base font-semibold">常用内容</h2>
    <span class="text-xs text-gray-500">快速进入内容维护</span>
  </div>
  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
    <% %w[works infos people publications].each do |key| %>
      <% resource = Admin::Resource.new(key) %>
      <%= link_to admin_resource_path(resource), class: 'admin-quick-card group' do %>
        <span class="admin-feature-icon"><%= admin_resource_icon(resource) %></span>
        <div class="min-w-0 flex-1">
          <h3 class="text-sm font-medium text-gray-900"><%= resource.label %></h3>
          <p class="admin-quick-description" title="<%= admin_resource_description(resource) %>"><%= admin_resource_description(resource) %></p>
        </div>
        <%= admin_icon('arrow', class: 'w-5 h-5 text-gray-400 group-hover:text-indigo-600 flex-shrink-0') %>
      <% end %>
    <% end %>
  </div>
</section>
<section aria-labelledby="all-modules-heading">
  <div class="flex items-center justify-between mb-4"><h2 id="all-modules-heading" class="text-base font-semibold">全部管理模块</h2><span class="text-xs text-gray-500"><%= Admin::Resource.all.size %> 个模块</span></div>
  <div class="grid gap-6 md:grid-cols-2">
    <% admin_navigation_groups.each_with_index do |group, index| %>
      <section class="admin-panel overflow-hidden" aria-labelledby="module-group-<%= index %>">
        <div class="admin-module-heading"><h3 id="module-group-<%= index %>" class="text-base font-semibold"><%= group[:label] %></h3><span class="text-xs text-gray-500"><%= group[:resources].size %> 个模块</span></div>
        <nav class="admin-module-navigation" aria-labelledby="module-group-<%= index %>"><ul role="list" class="space-y-1">
          <% group[:resources].each do |resource| %>
            <li><%= link_to admin_resource_path(resource), class: 'admin-module-link' do %><%= admin_resource_icon(resource) %><span><%= resource.label %></span><% end %></li>
          <% end %>
        </ul></nav>
      </section>
    <% end %>
  </div>
</section>
<p class="mt-6 text-xs text-gray-500 leading-relaxed">中文与 English 内容分别维护，可通过右上角切换内容语言。</p>
